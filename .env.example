# Expenzzi Environment Variables Example
# Duplicate this file as .env and fill in the values

# Database Connection (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# Neon Auth Configuration
NEON_AUTH_BASE_URL="https://unconfigured-neon-auth-url.neon.tech"
NEON_AUTH_COOKIE_SECRET="a-very-long-secure-fallback-cookie-secret-key-32-chars-long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
